@model IEnumerable<Activity>
<div class="d-flex justify-content-between mb-3"><h2>Activities</h2><a class="btn btn-primary" asp-action="Create">+ Add Activity</a></div><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Subject</th><th>Type</th><th>Date</th><th>Notes</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Subject</td><td>@x.ActivityType</td><td>@x.ActivityDate.ToShortDateString()</td><td>@x.Notes</td><td><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div>
