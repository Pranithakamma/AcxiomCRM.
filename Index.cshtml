@model IEnumerable<FollowUp>
<div class="d-flex justify-content-between mb-3"><h2>Follow-ups</h2><a class="btn btn-primary" asp-action="Create">+ Add Follow-up</a></div><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Subject</th><th>Date</th><th>Notes</th><th>Completed</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Subject</td><td>@x.FollowUpDate.ToShortDateString()</td><td>@x.Notes</td><td>@x.Completed</td><td><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div>
