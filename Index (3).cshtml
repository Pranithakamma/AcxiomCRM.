@model IEnumerable<Customer>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Customers</h2><a class="btn btn-primary" asp-action="Create">+ Add Customer</a></div>
<form class="row g-2 mb-3"><div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search name, email or company" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form>
<div class="card p-3 table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th></th></tr></thead><tbody>
@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Company</td><td>@c.Email</td><td>@c.Phone</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a></td></tr>}
</tbody></table></div>
