@model IEnumerable<Opportunity>
<div class="d-flex justify-content-between mb-3"><h2>Opportunities</h2><a class="btn btn-primary" asp-action="Create">+ Add Opportunity</a></div><form class="row g-2 mb-3"><div class="col-md-5"><input name="search" class="form-control" value="@ViewBag.Search" placeholder="Search opportunity or stage"/></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Name</th><th>Amount</th><th>Probability</th><th>Stage</th><th>Expected close</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Amount.ToString("C")</td><td>@x.Probability%</td><td>@x.Stage</td><td>@x.ExpectedCloseDate.ToShortDateString()</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div>
