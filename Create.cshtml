@model FollowUp
<h2>Add Follow-up</h2><div class="card p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger"></span></div><div class="mb-3"><label asp-for="FollowUpDate"></label><input asp-for="FollowUpDate" type="date" class="form-control"/><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="mb-3"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea></div><div class="form-check mb-3"><input asp-for="Completed" class="form-check-input"/><label asp-for="Completed" class="form-check-label"></label></div><button class="btn btn-primary">Save</button></form></div>
