@model Activity
<h2>Add Activity</h2><div class="card p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control"/></div><div class="mb-3"><label asp-for="ActivityType"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Email</option><option>Meeting</option><option>Task</option></select></div><div class="mb-3"><label asp-for="ActivityDate"></label><input asp-for="ActivityDate" type="date" class="form-control"/></div><div class="mb-3"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea></div><button class="btn btn-primary">Save</button></form></div>
