@using AcxiomCRM.Models
@{ ViewData["Title"] = "CRM Reports"; var customers = (IEnumerable<Customer>)ViewBag.Customers; var leads = (IEnumerable<Lead>)ViewBag.Leads; var opps = (IEnumerable<Opportunity>)ViewBag.Opportunities; var followups = (IEnumerable<FollowUp>)ViewBag.FollowUps; var audits = (IEnumerable<AuditLog>)ViewBag.AuditLogs; }
<h2 class="mb-3">CRM Reports</h2><div class="row g-3 mb-4">
<div class="col-md-3"><div class="card p-3"><div class="text-secondary">Customers</div><div class="fs-3 fw-bold">@ViewBag.CustomerCount</div><a asp-action="Export" asp-route-report="customers">Export CSV</a></div></div>
<div class="col-md-3"><div class="card p-3"><div class="text-secondary">Leads</div><div class="fs-3 fw-bold">@ViewBag.LeadCount</div><a asp-action="Export" asp-route-report="leads">Export CSV</a></div></div>
<div class="col-md-3"><div class="card p-3"><div class="text-secondary">Overdue follow-ups</div><div class="fs-3 fw-bold">@ViewBag.FollowUpOverdue</div><a asp-action="Export" asp-route-report="followups">Export follow-ups CSV</a></div></div>
<div class="col-md-3"><div class="card p-3"><div class="text-secondary">Weighted open pipeline</div><div class="fs-3 fw-bold">@(((decimal)ViewBag.WeightedPipeline).ToString("C"))</div><a asp-action="Export" asp-route-report="opportunities">Export opportunities CSV</a></div></div></div>
<div class="card p-3 mb-3"><h5>Opportunity pipeline by stage</h5><div class="table-responsive"><table class="table"><thead><tr><th>Stage</th><th>Count</th><th>Total amount</th><th>Weighted amount</th></tr></thead><tbody>@foreach(var g in opps.GroupBy(x=>x.Stage).OrderBy(x=>x.Key)){<tr><td>@g.Key</td><td>@g.Count()</td><td>@g.Sum(x=>x.Amount).ToString("C")</td><td>@g.Sum(x=>x.Amount*x.Probability/100m).ToString("C")</td></tr>}</tbody></table></div></div>
<div class="card p-3 mb-3"><div class="d-flex justify-content-between"><h5>Recent customers</h5><a asp-action="Export" asp-route-report="customers">Export full report</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Company</th><th>Created</th></tr></thead><tbody>@foreach(var x in customers){<tr><td>@x.Name</td><td>@x.Email</td><td>@x.Company</td><td>@x.CreatedDate.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div></div>
<div class="card p-3 mb-3"><div class="d-flex justify-content-between"><h5>Lead status report</h5><a asp-action="Export" asp-route-report="leads">Export full report</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody>@foreach(var g in leads.GroupBy(x=>x.Status).OrderBy(x=>x.Key)){<tr><td>@g.Key</td><td>@g.Count()</td></tr>}</tbody></table></div></div>
<div class="card p-3 mb-3"><div class="d-flex justify-content-between"><h5>Recent audit events</h5><a asp-action="Export" asp-route-report="audit">Export audit CSV</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Date (UTC)</th><th>User</th><th>Action</th><th>Module</th><th>Record</th></tr></thead><tbody>@foreach(var x in audits){<tr><td>@x.CreatedDate.ToString("g")</td><td>@x.UserId</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.RecordId</td></tr>}</tbody></table></div></div>
