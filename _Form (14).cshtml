@model Lead
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div><div class="mb-3"><label asp-for="Source"></label><input asp-for="Source" class="form-control"/></div><div class="mb-3"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div><div class="mb-3"><label asp-for="Priority"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Normal</option><option>High</option></select></div><div class="mb-3"><label asp-for="AssignedUserId">Assigned sales executive (user ID)</label><input asp-for="AssignedUserId" class="form-control"/></div><div class="mb-3"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea></div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>