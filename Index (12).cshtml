@model IEnumerable<AcxiomCRM.Controllers.UserRow>
@{ ViewData["Title"] = "User & Role Management"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>User & Role Management</h2><a class="btn btn-primary" asp-action="Create">Create user</a></div>
@if (TempData["Message"] != null) { <div class="alert alert-info">@TempData["Message"]</div> }
<div class="card p-3 table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Email</th><th>Primary role</th><th>Account status</th><th>Change role</th><th>Action</th></tr></thead><tbody>
@foreach (var u in Model) { <tr><td>@u.FullName</td><td>@u.Email</td><td>@u.Role</td><td><span class="badge @(u.Locked ? "bg-danger" : "bg-success")">@(u.Locked ? "Deactivated / Locked" : "Active")</span></td><td><form asp-action="ChangeRole" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@u.Id"/><select name="role" class="form-select form-select-sm"><option selected="@(u.Role == "Admin")">Admin</option><option selected="@(u.Role == "Manager")">Manager</option><option selected="@(u.Role == "SalesExecutive")">SalesExecutive</option></select><button class="btn btn-sm btn-outline-primary" type="submit">Save</button></form></td><td><form asp-action="ToggleLockout" method="post"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm @(u.Locked ? "btn-success" : "btn-outline-danger")" type="submit">@(u.Locked ? "Activate" : "Deactivate")</button></form></td></tr> }
</tbody></table></div>
