@{ ViewData["Title"] = "Initial Admin Setup"; }
<h2>Initial Admin Setup</h2><div class="alert alert-warning">Use this only for the first setup. It succeeds only when no Admin account exists. Remove the SetupController before production deployment.</div>
<form asp-action="ClaimAdmin" method="post" class="card p-4" style="max-width:600px"><label class="form-label" for="confirm">Type CLAIM ADMIN to assign the Admin role to your signed-in account</label><input id="confirm" name="confirm" class="form-control mb-3" required/><button class="btn btn-primary" type="submit">Claim Admin role</button></form>
